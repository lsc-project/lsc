#   Jonathan Clarke <jon@lsc-project.org>
#   Remy-Christophe Schermesser <rcs@lsc-project.org>
#
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# work out where LSC lives
LSC_HOME=$(dirname "${BASH_SOURCE}")/..
if [ ${LSC_HOME:0:1} != "/" ] ; then
        LSC_HOME="${PWD}/${LSC_HOME}"
fi

# ---------------------------------------------------------------------------------
# CONFIGURATION
# ---------------------------------------------------------------------------------

# LSC directories
CFG_DIR="$LSC_HOME/etc"
LIB_DIR="$LSC_HOME/lib"
LOG_DIR="/tmp"
LOG_FILE="$LOG_DIR/h2.log"
VAR_DIR="$LSC_HOME/var"

# H2 jar file (resolve glob at assignment; quoting at use would break expansion)
H2_LIB=$(echo "$LIB_DIR"/h2*.jar)

# Temporary directory so that H2 server could store files
H2_DIR=$VAR_DIR/h2
# Database file path — shared by Shell (file:) and TCP server (-baseDir)
H2_DB="${H2_DIR}/lscdb"
H2_URL="jdbc:h2:file:${H2_DB}"

# H2 server PID file
H2_PIDFILE=$VAR_DIR/h2.pid

# Table name
H2_TABLE=csvdata

# Default CSV separator
CSV_SEPARATOR=";"

# ---------------------------------------------------------------------------------
# FUNCTIONS
# ---------------------------------------------------------------------------------
function log() {
  echo "$(date "+${DATE_FORMAT:-%Y/%m/%d %T}") [h2] $1" >> "$LOG_FILE"
}

function fatal() {
  log "$1"
  echo "$(date "+${DATE_FORMAT:-%Y/%m/%d %T}") [h2] $1" 1>&2
  exit 1
}

# Escape a value for use inside a single-quoted SQL string literal.
function sql_escape() {
  printf '%s' "${1//\'/\'\'}"
}

#
# Drop all data from the H2 instance.
#
data_drop()
{
  h2_sqlQuery "DROP TABLE IF EXISTS $H2_TABLE" 2> /dev/null
  if [ $? -eq 0 ]; then
    log "Table $H2_TABLE deleted"
  else
    fatal "Unable to delete table $H2_TABLE"
  fi
}

#
# Create the SQL table into the H2 database. All field are read from the first
# line of the CSV file passed in the first parameter. Once the table is created,
# data should be correctly imported.
#
data_import()
{
  # $1 : CSV fullpath
  # $2 : CSV separator
  local csv_path csv_sep
  csv_path=$(sql_escape "$1")
  csv_sep=$(sql_escape "${2:-$CSV_SEPARATOR}")
  # H2 CSVREAD defaults to comma; pass fieldSeparator explicitly (2.x csvOptions form)
  if h2_sqlQuery "DROP TABLE IF EXISTS $H2_TABLE" \
    && h2_sqlQuery "CREATE TABLE $H2_TABLE AS SELECT * FROM CSVREAD('$csv_path', null, 'fieldSeparator=$csv_sep')"; then
    nblines=$(tail -n +2 "$1" | wc -l)
    log "File $1 imported into $H2_TABLE ($nblines rows)"
    echo "$nblines lines imported into table $H2_TABLE"
  else
    fatal "Unable to import $1 into table $H2_TABLE"
  fi
}

#
# Show data from the H2 instance.
#
data_show()
{
  h2_sqlQuery "SELECT * FROM $H2_TABLE" 2> /dev/null
}

#
# Check if the H2 server is running or not. This function should check a
# process from the PIDFILE into the process list.
#
h2_checkInstance()
{
  if [ ! -e "$H2_PIDFILE" ]; then
    echo 1
    return
  fi
  pid=$(cat "$H2_PIDFILE")
  if ! kill -0 "$pid" 2>/dev/null; then
    echo 1
    return
  fi
  echo 0
}

#
# Remove all data on disk that have been created by an h2 server. No checks
# on a running process are performed, so be carefull.
#
h2_cleanData()
{
  cd $H2_DIR > /dev/null 2>&1
  if [ $? -eq 0 ]; then
    rm -f *
    cd ..
    rmdir `basename $H2_DIR`
  fi
  rm -f $H2_PIDFILE > /dev/null 2>&1
}

#
# Perform a SQL query on the H2 database. No checks on a running
# process are performed, so be carefull.
#
h2_sqlQuery()
{
  # $1 : sql query
  local output rc
  output=$(java -cp "$H2_LIB" org.h2.tools.Shell \
    -url "$H2_URL" -user sa -password "" -sql "$1" 2>&1)
  rc=$?
  printf '%s\n' "$output"
  # org.h2.tools.Shell prints SQL errors but always exits 0; detect them here.
  if [ "$rc" -ne 0 ] || printf '%s\n' "$output" | grep -q '^Error:'; then
    return 1
  fi
  return 0
}

#
# Start an instance of a H2 TCP server. No checks on a running process are
# performed, so be carefull.
#
h2_startServer()
{
  mkdir -p "$H2_DIR"
  # -baseDir makes tcp://localhost/lscdb resolve to ${H2_DIR}/lscdb (same file as Shell).
  # No -tcpAllowOthers: remote connections stay disabled (localhost only).
  # Sample-only shutdown password for local TCP management.
  java -cp "$H2_LIB" org.h2.tools.Server \
    -tcp -baseDir "$H2_DIR" -ifNotExists -tcpPassword "shutdown" > /dev/null 2>&1 &
  echo $! > "$H2_PIDFILE"
  sleep 2
}

#
# Hard stop the current instance of H2 server. No checks on a running process
# are performed, so be carefull.
#
h2_stopServer()
{
  java -cp "$H2_LIB" org.h2.tools.Server \
    -tcpShutdown "tcp://localhost:9092" -tcpPassword "shutdown" 2> /dev/null || true
  if [ -f "$H2_PIDFILE" ]; then
    kill -s KILL "$(cat "$H2_PIDFILE")" 2> /dev/null || true
    rm -f "$H2_PIDFILE"
  fi
}

# ---------------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------------

# -- Check script parameters --

ACTIONS=""

case "$1" in
  "--drop")
    shift
    if [ "$1" != "" ]; then
      H2_TABLE="$1"
      shift
    fi
    ACTIONS="$ACTIONS dropdata"
    shift
    ;;
  "--import")
    shift
    CSV_FILE="$1"
    shift
    if [ "$1" != "" ]; then
      H2_TABLE="$1"
      shift
    fi
    if [ "$1" != "" ]; then
      CSV_SEPARATOR="$1"
      shift
    fi
    ACTIONS="$ACTIONS importdata"
    ;;
  "--show")
    shift
    if [ "$1" != "" ]; then
      H2_TABLE="$1"
      shift
    fi
    ACTIONS="$ACTIONS showdata"
    shift
    ;;
  "--start")
    ACTIONS="$ACTIONS startserver"
    shift
    ;;
  "--stop")
    ACTIONS="$ACTIONS stopserver"
    shift
    ;;
  "--status")
    ACTIONS="$ACTIONS status"
    shift
    ;;
  "--help"|*)
    echo ""
    echo " $0 [<option>]"
    echo ""
    echo " One option from available options is:"
    echo "   --import <file> [<table>] [<separator>]    Import data from CSV file"
    echo "   --drop [<table>]   Drop data"
    echo "   --show [<table>]   Show data from database"
    echo "   --start   Start the server"
    echo "   --stop    Stop the server"
    echo "   --status  Display server status"
    echo "   --help    Print informations"
    echo ""
    exit 1
    ;;
esac

# -- Run actions --

for action in $ACTIONS; do
  case "$action" in
    "dropdata")
      if [ `h2_checkInstance` -eq 1 ]; then
        echo " Error - server is not running"
        exit 1
      fi
      data_drop
      ;;
    "importdata")
      if [ ! -e "$CSV_FILE" ]; then
        echo " Error - file '$CSV_FILE' not found"
        exit 1
      fi
      if [ `h2_checkInstance` -eq 1 ]; then
        echo " Error - server is not running"
        exit 1
      fi
      data_import "$CSV_FILE" "$CSV_SEPARATOR"
      ;;
    "showdata")
      if [ `h2_checkInstance` -eq 1 ]; then
        echo " Error - server is not running"
        exit 1
      fi
      data_show
      ;;
    "startserver")
      if [ `h2_checkInstance` -eq 0 ]; then
        echo " Error - server already running"
        exit 1
      fi
      h2_cleanData
      h2_startServer
      ;;
    "stopserver")
      if [ `h2_checkInstance` -eq 0 ]; then
        h2_stopServer
        h2_cleanData
      fi
      ;;
    "status")
      if [ `h2_checkInstance` -eq 0 ]; then
        pid=`cat $H2_PIDFILE`
	echo "H2 Server is running (PID $pid)"
        exit 0
      else
	echo "H2 Server is not running"
        exit 1
      fi

  esac
done
