# ---------------------------------------------------------------------------------
# CONFIGURATION
# ---------------------------------------------------------------------------------

# work out where LSC sample lives
SAMPLE_HOME=$(dirname "${BASH_SOURCE}")/..
if [ ${SAMPLE_HOME:0:1} != "/" ] ; then
        SAMPLE_HOME="${PWD}/${SAMPLE_HOME}"
fi
CONFIGPATH="${SAMPLE_HOME}/etc"

LSC_LIB_DIR="${SAMPLE_HOME}/../../lib"
LSC_SAMPLE_LIB_DIR="${SAMPLE_HOME}/../lib"
LSC_BIN_DIR="${SAMPLE_HOME}/../../bin"

# H2 jar file
[ -z "$H2_LIB" -a -e "${LSC_LIB_DIR}"/h2*.jar ] && H2_LIB=$( readlink -f "${LSC_LIB_DIR}"/h2*.jar )
[ -z "$H2_LIB" -a -e "${LSC_SAMPLE_LIB_DIR}"/h2*.jar ] && H2_LIB=$( readlink -f "${LSC_SAMPLE_LIB_DIR}"/h2*.jar )
[ -z "$H2_LIB" ] && echo "h2 driver (h2*.jar) is missing" && exit 1
# Temporary directory so that H2 server could store files
H2_DIR=/tmp/lsc/h2
# Database file path — shared by Shell (file:) and TCP server (-baseDir)
H2_DB="${H2_DIR}/lscdb"
H2_URL="jdbc:h2:file:${H2_DB}"
# Table name
H2_TABLE=userdata
H2_TABLEDEF="ID VARCHAR,UID VARCHAR,MAIL VARCHAR,MAIL_LOWER VARCHAR,LAST_UPDATE TIMESTAMP, STATUS BOOLEAN, ENDOFVALIDITY VARCHAR,SN VARCHAR,CN VARCHAR,GIVENNAME VARCHAR,O VARCHAR,ADDRESS VARCHAR,TELEPHONENUMBER VARCHAR,CARLICENSE VARCHAR"

# ---------------------------------------------------------------------------------
# FUNCTIONS
# ---------------------------------------------------------------------------------

#
# Drop all data from the H2 instance.
#
data_drop()
{
  h2_sqlQuery "DROP TABLE IF EXISTS ${H2_TABLE}"
}

#
# Create table in the H2 instance.
#
data_create()
{
	h2_sqlQuery "CREATE TABLE ${H2_TABLE} (${H2_TABLEDEF})"
}

#
# Show data from the H2 instance.
#
data_show()
{
  h2_sqlQuery "SELECT * FROM ${H2_TABLE}"
}

#
# Remove all data on disk that have been created by an h2 server. No checks
# on a running process are performed, so be carefull.
#
h2_cleanData()
{
  oldpwd=`pwd`
  cd ${H2_DIR} > /dev/null 2>&1
  if [ $? -eq 0 ]; then
    rm -f *
    cd ..
    rmdir `basename "${H2_DIR}"`
  fi
  cd ${oldpwd}
}

#
# Perform a SQL query on the H2 database. No checks on a running
# process are performed, so be carefull.
#
h2_sqlQuery()
{
  # $1 : sql query
  local output rc
	# check if we have java executable
	get_java

	output=$("${JAVA_COMMAND}" -cp "$H2_LIB" org.h2.tools.Shell \
		-url "$H2_URL" -user sa -password "" -sql "$1" 2>&1)
	rc=$?
	printf '%s\n' "$output"
	# org.h2.tools.Shell prints SQL errors but always exits 0; detect them here.
	if [ "$rc" -ne 0 ] || printf '%s\n' "$output" | grep -q '^Error:'; then
		return 1
	fi
	return 0
}

# Determine where the java exectuable is
function get_java() {
    # Do we have a JAVA_HOME environment variable?
    if [ "z" != "z${JAVA_HOME}" ]; then
        JAVA_COMMAND="${JAVA_HOME}/bin/java"
        return
    fi  

    # Try java command on PATH as an alternative
    JAVA_COMMAND="$(which java 2>/dev/null)"
    if [ -e "$JAVA_COMMAND" ]; then return; fi

    # Nothing seems approprite, warn and exit
    echo "No java executable found on PATH or in JAVA_HOME! Aborting."
    echo "Define JAVA_HOME or adjust your PATH variable to include java."
    exit 2
}

run_java_command()
{
        # check if we have java executable
        get_java

        for jar in "${LSC_LIB_DIR}"/*.jar "${LSC_SAMPLE_LIB_DIR}"/*.jar; do
                [ -e "$jar" ] && LDAPCP="$LDAPCP:$jar"
        done

        "${JAVA_COMMAND}" \
                -cp "$LDAPCP" \
                --add-exports java.base/sun.security.tools.keytool=ALL-UNNAMED \
                --add-exports java.base/sun.security.x509=ALL-UNNAMED \
				--add-opens java.base/java.lang=ALL-UNNAMED \
				--add-opens java.base/java.util=ALL-UNNAMED \
				--add-opens java.base/sun.security.x509=ALL-UNNAMED $1 $2 $3 $4 $5
}

start_ldap() {
	echo "Starting LDAP server on ldap://localhost:33389/ ..."
	run_java_command "org.lsc.opendj.LdapServer -a -f ${CONFIGPATH}"
}

start_h2() {
	echo "Starting H2 TCP server on localhost:9092 ..."
	mkdir -p "${H2_DIR}"
	get_java
	# -baseDir makes tcp://localhost/lscdb resolve to ${H2_DIR}/lscdb (same file as Shell).
	# No -tcpAllowOthers: remote connections stay disabled (localhost only).
	# Sample-only shutdown password for local TCP management.
	"${JAVA_COMMAND}" -cp "$H2_LIB" org.h2.tools.Server \
		-tcp -baseDir "${H2_DIR}" -ifNotExists -tcpPassword "shutdown" &
	echo $! > "${H2_DIR}/h2.pid"
	sleep 2
	echo "H2 TCP server started"
}

stop_h2() {
	if [ -f "${H2_DIR}/h2.pid" ]; then
		get_java
		"${JAVA_COMMAND}" -cp "$H2_LIB" org.h2.tools.Server \
			-tcpShutdown "tcp://localhost:9092" -tcpPassword "shutdown" 2>/dev/null || true
		kill -s KILL "$(cat "${H2_DIR}/h2.pid")" 2>/dev/null || true
		rm -f "${H2_DIR}/h2.pid"
		echo "H2 TCP server stopped"
	else
		echo "H2 TCP server is not running"
	fi
}

start_dbtool() {
	echo "Starting H2 Console ..."
	get_java
	"${JAVA_COMMAND}" -cp "$H2_LIB" org.h2.tools.Console
}

run() {
	SYNCTASK=$1
	if [ -z "$SYNCTASK" ]; then
		SYNCTASK=all
	fi
	CLEANTASK=$2
	if [ -n "$CLEANTASK" ]; then
		CLEANTASK="--clean $CLEANTASK"
	fi
	
	command="\"${SAMPLE_HOME}/../../bin/lsc\" --config \"${CONFIGPATH}\" -t 1 --synchronize ${SYNCTASK} ${CLEANTASK}"
	echo "Running $command"
	eval "${command}"
}

# ---------------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------------

# -- Check script parameters --

ACTIONS=""

case "$1" in
  "--drop")
    ACTIONS="$ACTIONS dropdata"
    shift
    ;;
  "--create")
    ACTIONS="$ACTIONS createdata"
    shift
    ;;
  "--show")
    ACTIONS="$ACTIONS showdata"
    shift
    ;;
  "--sql")
    ACTIONS="$ACTIONS sql"
    shift
    SQL_COMMAND="$1"
    shift
    ;;
  "--dbtool")
    ACTIONS="$ACTIONS startdbtool"
    shift
    ;;
  "--start-ldap-server")
    ACTIONS="$ACTIONS startldap"
	shift
	;;
  "--start-h2-server")
    ACTIONS="$ACTIONS starth2"
	shift
	;;
  "--stop-h2-server")
    ACTIONS="$ACTIONS stoph2"
	shift
	;;
  "--run")
	run LDAP2JDBCTask LDAP2JDBCTask
	shift
	;;
  "--set-ext-id")
	run SetExtIdTask
	shift
	;;
  "--clean")
	ACTIONS="$ACTIONS cleandata cleanldapdata"
	shift
	;;
  "--help"|*)
    echo ""
    echo " $0 <option>"
    echo ""
    echo " One option from available options is:"
    echo "  Database:"
    echo "   --start-h2-server      Launch an embedded H2 TCP server"
    echo "   --stop-h2-server       Halt an embedded H2 TCP server"
    echo "   --create               Create the table $H2_TABLE in database"
    echo "   --show                 Show data from database"
    echo "   --dbtool               Start H2 Console"
    echo "   --sql <command>        run sql command"
    echo "   --drop                 Drop the table $H2_TABLE from database"
    echo "  LDAP"
    echo "   --start-ldap-server    Launch an embedded OpenDJ LDAP server"
    echo "  Other functions"
    echo "   --run                  Run the synchronization task"
    echo "   --set-ext-id           Run task to set externalId"
    echo "   --clean                Remove all files from disk"
    echo "   --help                 Print informations"
    echo ""
    exit 1
    ;;
esac

# -- Run actions --

for action in $ACTIONS; do
  case "$action" in
    "dropdata")
      data_drop || exit 1
      ;;
    "createdata")
      data_create || exit 1
      ;;
    "showdata")
      data_show || exit 1
      ;;
    "sql")
      h2_sqlQuery "$SQL_COMMAND" || exit 1
      ;;
    "startldap")
      start_ldap
      ;;
    "stopldap")
      stop_ldap
      ;;
    "starth2")
      start_h2
      ;;
    "stoph2")
      stop_h2
      ;;
    "startdbtool")
      start_dbtool
      ;;
    "cleandata")
      h2_cleanData
      ;;
    "cleanldapdata")
      rm -rf /tmp/opendj-test
      ;;
  esac
done
