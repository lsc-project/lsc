# ---------------------------------------------------------------------------------
# CONFIGURATION
# ---------------------------------------------------------------------------------

# work out where LSC sample lives
SAMPLE_HOME=$(dirname "${BASH_SOURCE}")/..
if [ ${SAMPLE_HOME:0:1} != "/" ] ; then
	SAMPLE_HOME="${PWD}/${SAMPLE_HOME}"
fi
CONFIGPATH="${SAMPLE_HOME}/etc"

LSC_LIB_DIR="${SAMPLE_HOME}/../../lib"
LSC_SAMPLE_LIB_DIR="${SAMPLE_HOME}/../lib"
LSC_BIN_DIR="${SAMPLE_HOME}/../../bin"

# H2 jar file
[ -z "$H2_LIB" -a -e "${LSC_LIB_DIR}"/h2*.jar ] && H2_LIB=$( readlink -f "${LSC_LIB_DIR}"/h2*.jar )
[ -z "$H2_LIB" -a -e "${LSC_SAMPLE_LIB_DIR}"/h2*.jar ] && H2_LIB=$( readlink -f "${LSC_SAMPLE_LIB_DIR}"/h2*.jar )
[ -z "$H2_LIB" ] && echo "h2 driver (h2*.jar) is missing" && exit 1
# Temporary directory so that H2 server could store files
H2_DIR="/tmp/lsc/h2"
# Database file path — must match sample/h2/etc/lsc.xml
H2_DB="${H2_DIR}/lsc"
H2_URL="jdbc:h2:file:${H2_DB}"
# Table name
H2_TABLE="csvdata"
# Default CSV separator
CSV_SEPARATOR=";"

# ---------------------------------------------------------------------------------
# FUNCTIONS
# ---------------------------------------------------------------------------------

#
# Drop all data from the H2 instance.
#
data_drop()
{
  h2_sqlQuery "DROP TABLE IF EXISTS $H2_TABLE"
}

#
# Create the SQL table into the H2 database. All field are read from the first
# line of the CSV file passed in the first parameter. Once the table is created,
# data should be correctly imported.
#
data_import()
{
  # $1 : CSV fullpath
  # $2 : CSV separator
  local csv_path csv_sep
  csv_path=$(sql_escape "$1")
  csv_sep=$(sql_escape "${2:-$CSV_SEPARATOR}")
  mkdir -p "$H2_DIR"
  # H2 CSVREAD defaults to comma; pass fieldSeparator explicitly (2.x csvOptions form)
  if h2_sqlQuery "CREATE TABLE $H2_TABLE AS SELECT * FROM CSVREAD('$csv_path', null, 'fieldSeparator=$csv_sep')"; then
    nblines=$(tail -n +2 "$1" | wc -l)
    echo "$nblines lines imported into table $H2_TABLE"
    return 0
  fi
  exit 1
}

#
# Show data from the H2 instance.
#
data_show()
{
  h2_sqlQuery "SELECT * FROM $H2_TABLE"
}

#
# Remove all data on disk that have been created by an h2 server. No checks
# on a running process are performed, so be carefull.
#
h2_cleanData()
{
  oldpwd=`pwd`
  cd ${H2_DIR} > /dev/null 2>&1
  if [ $? -eq 0 ]; then
    rm -f *
    cd ..
    rmdir `basename "${H2_DIR}"`
  fi
  cd ${oldpwd}
}

# Escape a value for use inside a single-quoted SQL string literal.
sql_escape()
{
  printf '%s' "${1//\'/\'\'}"
}

#
# Perform a SQL query on the H2 database. Returns non-zero on SQL failure
# (org.h2.tools.Shell always exits 0, so errors are detected from its output).
#
h2_sqlQuery()
{
  # $1 : sql query
  local output rc

	# check if we have java executable
	get_java

	output=$("${JAVA_COMMAND}" -cp "$H2_LIB" org.h2.tools.Shell \
		-url "$H2_URL" -user sa -password "" -sql "$1" 2>&1)
	rc=$?
	printf '%s\n' "$output"
	# Shell prints SQL errors as a line ending in "; SQL statement:" but exits 0.
	# Data rows are rendered with table pipes, so they will not match this pattern.
	if [ "$rc" -ne 0 ] || printf '%s\n' "$output" | grep -q '^Error: org\.h2\..*; SQL statement:$'; then
		return 1
	fi
	return 0
}

# Determine where the java exectuable is
function get_java() {
    # Do we have a JAVA_HOME environment variable?
    if [ "z" != "z${JAVA_HOME}" ]; then
        JAVA_COMMAND="${JAVA_HOME}/bin/java"
        return
    fi  

    # Try java command on PATH as an alternative
    JAVA_COMMAND="$(which java 2>/dev/null)"
    if [ -e "$JAVA_COMMAND" ]; then return; fi

    # Nothing seems approprite, warn and exit
    echo "No java executable found on PATH or in JAVA_HOME! Aborting."
    echo "Define JAVA_HOME or adjust your PATH variable to include java."
    exit 2
}

run_java_command()
{
	# check if we have java executable
	get_java

	for jar in "${LSC_LIB_DIR}"/*.jar "${LSC_SAMPLE_LIB_DIR}"/*.jar; do
		[ -e "$jar" ] && LDAPCP="$LDAPCP:$jar"
	done

	"${JAVA_COMMAND}" \
		-cp "$LDAPCP" \
		--add-exports java.base/sun.security.tools.keytool=ALL-UNNAMED \
		--add-exports java.base/sun.security.x509=ALL-UNNAMED \
		--add-opens java.base/java.lang=ALL-UNNAMED \
		--add-opens java.base/java.util=ALL-UNNAMED \
		--add-opens java.base/sun.security.x509=ALL-UNNAMED $1
}

start_ldap() {
	echo "Starting LDAP server on ldap://localhost:33389/ ..."
	run_java_command "org.lsc.opendj.LdapServer -a -f ${CONFIGPATH}"
}

run() {
	command="\"${LSC_BIN_DIR}/lsc\" --config \"$CONFIGPATH\" --synchronize all --clean all"
	echo "Running $command"
	eval "${command}"
}

# ---------------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------------

# -- Check script parameters --

ACTIONS=""

case "$1" in
  "--drop")
    ACTIONS="$ACTIONS dropdata"
    shift
    ;;
  "--import")
    shift
    CSV_FILE="$1"
    shift
    if [ "$1" != "" ]; then
      CSV_SEPARATOR="$1"
      shift
    fi
    ACTIONS="$ACTIONS cleandata importdata"
    ;;
  "--show")
    ACTIONS="$ACTIONS showdata"
    shift
    ;;
  "--start-ldap-server")
    ACTIONS="$ACTIONS startldap"
	shift
	;;
  "--run")
	run
	shift
	;;
  "--clean")
	ACTIONS="$ACTIONS cleandata cleanldapdata"
	shift
	;;
  "--help"|*)
    echo ""
    echo " $0 <option>"
    echo ""
    echo " One option from available options is:"
    echo "   --import <file> [<separator>]    Import data from CSV file"
    echo "   --show    Show data from database"
    echo "   --drop    Drop the table $H2_TABLE from database"
    echo "   --start-ldap-server    Launch an embedded OpenDJ LDAP server"
    echo "   --run     Run the synchronization task"
	echo "   --clean   Remove all files from disk"
    echo "   --help    Print informations"
    echo ""
    exit 1
    ;;
esac

# -- Run actions --

for action in $ACTIONS; do
  case "$action" in
    "dropdata")
      data_drop || exit 1
      ;;
    "importdata")
      if [ ! -e "$CSV_FILE" ]; then
        echo " Error - file '$CSV_FILE' not found"
        exit 1
      fi
      data_import "$CSV_FILE" "$CSV_SEPARATOR"
      ;;
    "showdata")
      data_show || exit 1
      ;;
    "startldap")
      start_ldap
      ;;
    "cleandata")
      h2_cleanData
      ;;
    "cleanldapdata")
      rm -rf /tmp/opendj-test
      ;;
  esac
done
